+++ b/servers/rendering/renderer_rd/shaders/raytracing/raytracing_hit_inc.glsl
@@ -161,6 +161,13 @@ vec2 fetch_uv_at(in GeometryData geom, uint byte_offset, uint scale_packed, uint
 	return bary.x * uv0 + bary.y * uv1 + bary.z * uv2;
 }
 
+// Road Rage Trip uses FLOAT4 CUSTOM0 for procedural window parameters.
+vec4 fetch_custom0_vertex(in GeometryData geom, uint index) {
+	FloatBuffer attributes = FloatBuffer(geom.attribute_address);
+	uint offset = (index * geom.attribute_stride + geom.custom0_byte_offset) >> 2;
+	return vec4(attributes.v[offset], attributes.v[offset + 1u], attributes.v[offset + 2u], attributes.v[offset + 3u]);
+}
+
 vec2 fetch_uv(in GeometryData geom, uint i0, uint i1, uint i2, vec3 bary) {
 	return fetch_uv_at(geom, geom.uv_byte_offset, geom.uv_scale_packed, i0, i1, i2, bary);
 }

; Road Rage Trip - Godot client (0.20.0beta).
; Python is the authoritative simulation; this project only presents it.
; See docs/architecture/godot-client.md.

config_version=5

[application]

config/name="Road Rage Trip (Godot client)"
config/version="0.20.0beta"
run/main_scene="res://startup.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

interior_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
interior_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
interior_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
interior_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048

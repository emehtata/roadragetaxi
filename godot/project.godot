; Road Rage Trip - Godot client (0.16.0g-alpha experiment).
; Python is the authoritative simulation; this project only presents it.
; See docs/architecture/godot-client.md.

config_version=5

[application]

config/name="Road Rage Trip (Godot client)"
config/version="0.16.0g-alpha"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"

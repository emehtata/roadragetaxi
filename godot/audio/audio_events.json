{
  "_doc": "Semantic simulation events -> sounds, for audio_manager.gd. Sounds are groups of the game's catalog (src/theroadragetrip/assets/audio/audio_catalog.json, all Stable Audio Open generated OGG); a 'sound' event names its group directly and plays one of its variations at random. Loops play a fixed variation (default the first), or with \"variation\": \"alternate\" a different one each time they (re)start. Ranges mirror audio.py's SPATIAL_RANGES_M: [full volume within, silent beyond] metres.",
  "catalog": "../src/theroadragetrip/assets/audio/audio_catalog.json",
  "buses": {
    "Game": [
      "vehicle",
      "collision",
      "taxi",
      "passenger",
      "gameplay",
      "pedestrian",
      "railway",
      "station"
    ],
    "Environment": [
      "ambient",
      "weather"
    ],
    "UI": [
      "ui"
    ]
  },
  "events": {
    "train_arrived": [
      {
        "group": "railway.train_brakes"
      },
      {
        "group": "railway.train_doors",
        "variation": 1,
        "volume": 0.7
      }
    ],
    "train_departed": [
      {
        "group": "railway.train_doors",
        "variation": 0,
        "volume": 0.7
      },

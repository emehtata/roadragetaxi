## The text for `key` in `language` (fi, en or de); a key missing from a table
## shows in English, one missing from both shows as the key.
static func text(key: String, language: String) -> String:
	var table: Dictionary = DE if language == "de" else (FI if language == "fi" else EN)
	return table.get(key, EN.get(key, key))

static func weather(value: String, language: String) -> String:
	return text("weather_" + value, language) if EN.has("weather_" + value) else value.capitalize()


static func value_label(value, language: String) -> String:
	if value == null or str(value) == "":
		return text("unknown", language)
	var key := "value_" + str(value).to_lower()
	return text(key, language) if EN.has(key) else str(value).to_lower().replace("_", " ")


static func startup_detail(value: String, language: String) -> String:
	# "Message|counter": translate the message, keep the language-neutral counter.
	if "|" in value:
		var parts := value.split("|", true, 1)
		return startup_detail(parts[0], language) + "  " + parts[1]
	const DETAILS := {
		"Initializing scenery engine...": "Alustetaan karttamoottoria…",
		"Preparing road index...": "Rakennetaan tiehakemistoa…",
		"Preparing house parking...": "Valmistellaan talojen pysäköintipaikkoja…",
		"Preparing building and scenery indexes...": "Rakennetaan rakennusten ja maaston hakemistoja…",
		"Preparing railways and timetables...": "Valmistellaan rautateitä ja aikatauluja…",
		"Preparing taxi missions...": "Valmistellaan taksitehtäviä…",
		"Initializing intercity navigation database...": "Alustetaan kaupunkien välisen navigoinnin tietokantaa…",
		"Preparing taxi world...": "Valmistellaan taksin ympäristöä…",
		"Preparing NPC traffic...": "Valmistellaan muuta liikennettä…",
		"Preparing pedestrians...": "Valmistellaan jalankulkijoita…",
		"Starting game...": "Valmistellaan junia ja pelimaailmaa…",
		"Ready": "Karttapohja valmis",
		"road_grid": "Tiehakemisto", "building_grid": "Rakennushakemisto", "scenery_grid": "Maastohakemisto",
		"house_parking": "Talojen pysäköintipaikat", "small_grids": "Veden, kaiteiden ja liikenneohjausten hakemistot",
		"trees_under_roads": "Teiden alle jäävät puut",
	}
	const GERMAN_DETAILS := {
		"Initializing scenery engine...": "Landschaft wird vorbereitet…",
		"Preparing road index...": "Straßennetz wird vorbereitet…",
		"Preparing house parking...": "Parkplätze an Häusern werden vorbereitet…",
		"Preparing building and scenery indexes...": "Gebäude und Landschaft werden vorbereitet…",
		"Preparing railways and timetables...": "Bahnstrecken und Fahrpläne werden vorbereitet…",
		"Preparing taxi missions...": "Taxifahrten werden vorbereitet…",
		"Initializing intercity navigation database...": "Überland-Navigationsdatenbank wird initialisiert…",
		"Preparing taxi world...": "Taxi-Umgebung wird vorbereitet…",
		"Preparing NPC traffic...": "Verkehr wird vorbereitet…",
		"Preparing pedestrians...": "Fußgänger werden vorbereitet…",
		"Starting game...": "Züge und Spielwelt werden vorbereitet…",
		"Ready": "Kartengrundlage bereit",
		"road_grid": "Straßennetz", "building_grid": "Gebäude", "scenery_grid": "Landschaft",
		"house_parking": "Parkplätze an Häusern", "small_grids": "Wasser, Leitplanken und Verkehrsregeln",
		"trees_under_roads": "Bäume unter Straßen",
	}
	if language == "de":
		return GERMAN_DETAILS.get(value, value)
	return DETAILS.get(value, value) if language == "fi" else value
